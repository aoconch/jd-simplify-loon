#!name=京东精简·抓包诊断版(临时)
#!desc=仅供定位接口用：扩大 MITM 覆盖 + 给响应打 X-JD-Debug 标记，不做任何拦截与改写。诊断完请删除本插件
#!author=aoconch
#!version=1.0.0
#!support=Loon
#!homepage=https://github.com/aoconch/jd-simplify-loon

[Mitm]
hostname = api.m.jd.com, m.jd.com, pro.m.jd.com, h5.m.jd.com, item.m.jd.com, wq.jd.com, ms.jd.com, gw-e.jd.com, ccfjma.m.jd.com, ccflbs.m.jd.com, sh.jd.com, storage.360buyimg.com, apk.360buyimg.com

[Script]
http-response ^https?:\/\/(api|m|pro|h5|item|wq|ms|gw-e|ccfjma|ccflbs|sh)\.jd\.com\/ script-path=https://cdn.jsdelivr.net/gh/aoconch/jd-simplify-loon@6557494743e37eb4987b3f440fb096471b4abbae/jd-debug.js, tag=JD-Debug, enable=true
http-response ^https?:\/\/(storage|apk)\.360buyimg\.com\/ script-path=https://cdn.jsdelivr.net/gh/aoconch/jd-simplify-loon@6557494743e37eb4987b3f440fb096471b4abbae/jd-debug.js, tag=JD-Debug, enable=true
