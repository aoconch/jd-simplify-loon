#!name=京东首页与我的页精简
#!desc=精简京东 App 首页推荐流与「我的」页推广模块，去广告降噪（含首页 H5 网页去推荐）
#!author=aoconch
#!version=3.1.0
#!support=Loon
#!homepage=https://github.com/aoconch/jd-simplify-loon

[Mitm]
hostname = api.m.jd.com, ccfjma.m.jd.com, ccflbs.m.jd.com, sh.jd.com, pro.m.jd.com

[Script]
http-response ^https?:\/\/[a-zA-Z0-9.-]*\.jd\.com\/ script-path=https://raw.githubusercontent.com/aoconch/jd-simplify-loon/0f982f853999b8ae0ada28994dda64c390e5b8c0/jd-simplify.js, requires-body=true, timeout=10, tag=京东精简去广告, enable=true

[Rule]
URL-REGEX,^https?:\/\/mars\.jd\.com\/log,REJECT
URL-REGEX,^https?:\/\/perf\.m\.jd\.com\/,REJECT
URL-REGEX,^https?:\/\/anti-sdk-report\.m\.jd\.com\/,REJECT
URL-REGEX,^https?:\/\/cactus\.jd\.com\/,REJECT
URL-REGEX,^https?:\/\/sdkfp\.jd\.com\/,REJECT
URL-REGEX,^https?:\/\/mllog\.jd\.com\/,REJECT
URL-REGEX,^https?:\/\/waapdg\.jd\.com\/,REJECT
