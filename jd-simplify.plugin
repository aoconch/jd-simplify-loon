#!name=京东首页与我的页精简
#!desc=精简京东 App 首页推荐流与「我的」页推广模块，去广告降噪（基于捕获的 basicConfig 逆向）
#!author=aoconch
#!version=1.1.0
#!support=Loon
#!homepage=https://github.com/aoconch/jd-simplify-loon

[MITM]
hostname = %APPEND% api.m.jd.com, ccfjma.m.jd.com, ccflbs.m.jd.com, sh.jd.com

[Script]
http-response ^https?:\/\/api\.m\.jd\.com\/ script-path=https://raw.githubusercontent.com/aoconch/jd-simplify-loon/main/jd-simplify.js, requires-body=true, timeout=10, tag=京东精简去广告

[Rule]
# 屏蔽京东埋点/监控域名，减少后台噪声（可选，不影响功能）
AND,https://mars.jd.com/log,REJECT
AND,https://perf.m.jd.com/,REJECT
AND,https://anti-sdk-report.m.jd.com/,REJECT
